# ════════════════════════════════════════════════════════════════════════════════════════
#  Prime Arena — configuração de PRODUÇÃO
#  Copie este arquivo para ".env" no servidor (cp .env.production.example .env) e preencha.
#  O arquivo ".env" NUNCA vai para o GitHub nem para o zip: ele guarda as suas senhas.
#  Passo a passo completo: docs/HOSPEDAGEM.md
#  Se algo estiver errado, o site se recusa a subir e o motivo aparece em:  docker compose logs app
# ════════════════════════════════════════════════════════════════════════════════════════

# ───────── 1) Endereço do site ─────────
# O domínio SEM https:// (usado pelo Caddy para criar o certificado HTTPS automático).
DOMAIN="primearena1.com.br"
# O endereço completo, COM https:// (vai nos links dos e-mails de confirmação de conta e de recuperação de senha).
APP_URL="https://primearena1.com.br"

# ───────── 2) Segredos (gere com:  npm run secrets  — ou, sem Node instalado:  docker run --rm -v "$PWD/scripts:/s:ro" node:22-bookworm-slim node /s/gen-secrets.mjs) ─────────
# Cole aqui as linhas que o comando gerar. Guarde uma cópia FORA do servidor.
APP_SECRET=""
# Cifra o CPF dos usuários. SEM ELA OS CPFs JÁ SALVOS NÃO ABREM: faça backup e nunca troque depois de o site estar no ar.
DATA_ENCRYPTION_KEY=""
# Senha do agendador (o docker-compose já chama o site a cada 2 minutos com ela).
CRON_SECRET=""

# ───────── 3) Quem é o administrador ─────────
# O(s) e-mail(s) que viram ADMINISTRADOR do site. Crie a conta normalmente em /cadastro com este e-mail e
# confirme-o pelo link que chega: o cargo vale só DEPOIS do e-mail confirmado. Separe vários por vírgula.
ADMIN_EMAILS="voce@exemplo.com"

# ───────── 4) E-mail (confirmação de conta e recuperação de senha) — OBRIGATÓRIO ─────────
# Formato:  smtp://USUARIO:SENHA@SERVIDOR:587   ou   smtps://USUARIO:SENHA@SERVIDOR:465
# Se a senha tiver caracteres especiais (@ : / # ? $ %), troque cada um pelo código %XX (ex.: @ vira %40).
# Passo a passo com Brevo, Resend, Gmail e outros: docs/CONFIGURAR_EMAIL.md
SMTP_URL=""
# Nome e endereço que aparecem como remetente. O endereço precisa ser do seu domínio (ou um remetente verificado no provedor).
MAIL_FROM="Prime Arena <noreply@primearena1.com.br>"

# ───────── 5) Segurança de rede (já vem certo para o docker-compose com Caddy) ─────────
# "true" porque o Caddy fica na frente do site e informa o IP real do visitante. Não mude se usar o docker-compose.
TRUST_PROXY="true"

# ───────── 6) Pagamento da inscrição em campeonatos ─────────
# "none"   = campeonatos só GRATUITOS (não precisa de nada além do que está neste arquivo).  ← comece por aqui
# "stripe" = inscrição paga com cartão/Pix pela Stripe (preencha as duas linhas abaixo).
PAYMENTS_PROVIDER="none"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Taxa de serviço cobrada do jogador por cima do valor do organizador (1000 = 10%). Só vale com Stripe.
PLATFORM_FEE_BPS="1000"

# ───────── 7) Carteira de equipe, depósitos, saques e desafios (Pix) ─────────
# Comece com "false": o site funciona só com campeonatos. Quando terminar o tutorial docs/CONFIGURAR_PIX.md,
# troque para "true" e preencha as linhas abaixo; depois: docker compose up -d
WALLET_ENABLED="false"
PIX_PROVIDER="asaas"
ASAAS_ENV="sandbox"
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""
ASAAS_TRANSFER_AUTH_TOKEN=""
# "true" = todo depósito cujo pagador o provedor não informa fica retido para você conferir em Admin → Depósitos retidos.
# Recomendado ligar até validar tudo no sandbox do Asaas.
PIX_REQUIRE_PAYER_DOC="true"
# Freio de emergência: "true" suspende TODOS os saques sem derrubar o resto do site.
PAYOUTS_PAUSED="false"

# ───────── Limites (centavos). Os padrões já são conservadores — só mude se souber o que está fazendo ─────────
# DEPOSIT_MIN_CENTS=1000          DEPOSIT_MAX_CENTS=500000        DEPOSIT_DAILY_USER_CENTS=1000000
# WITHDRAW_MIN_CENTS=2000         WITHDRAW_MAX_CENTS=200000       WITHDRAW_DAILY_TEAM_CENTS=500000
# WITHDRAW_AUTO_APPROVE_MAX_CENTS=0   (0 = TODO saque espera a sua liberação em Admin → Saques)
# WITHDRAW_DELAY_MINUTES=30       DEPOSIT_HOLD_HOURS=72           WIN_HOLD_HOURS=24
