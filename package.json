{
  "name": "prime-arena",
  "version": "0.1.0",
  "private": true,
  "description": "Prime Arena — plataforma de campeonatos de esports com carteira por equipe e desafios (inspirada no Battlefy)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "predev": "node scripts/setup.mjs --if-needed",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "node scripts/setup.mjs",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "reset": "node scripts/reset-db.mjs",
    "db:reset": "node scripts/reset-db.mjs",
    "secrets": "node scripts/gen-secrets.mjs",
    "backup": "node scripts/backup-db.mjs",
    "mail:test": "tsx --env-file-if-exists=.env scripts/mail-test.ts",
    "verificar-site": "node scripts/check-site.mjs",
    "e2e": "playwright test",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-d1": "6.19.3",
    "@prisma/client": "^6.19.3",
    "drizzle-orm": "0.45.2",
    "next": "^16.3.8",
    "nodemailer": "^10.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "@opennextjs/cloudflare": "^1.20.9",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.10",
    "miniflare": "^4.20260515.0",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.125.0"
  }
}
