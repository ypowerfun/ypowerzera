# ───────── Banco de dados ─────────
# Desenvolvimento: SQLite. Produção: troque o provider em prisma/schema.prisma para "postgresql"
# e use uma URL como postgresql://user:pass@host:5432/ypowerzera
DATABASE_URL="file:./dev.db?connection_limit=1&socket_timeout=30"

# ───────── Aplicação ─────────
APP_URL="http://localhost:3000"
# Chave para assinar tokens internos (gere com: openssl rand -hex 32)
APP_SECRET="troque-esta-chave-em-producao"

# ───────── Pagamentos ─────────
# "mock" = checkout simulado (somente dev/testes). "stripe" = Stripe Checkout (cartão + Pix).
PAYMENTS_PROVIDER="mock"
# Em produção o provider mock é recusado, a menos que ALLOW_MOCK_PAYMENTS=true (não recomendado).
ALLOW_MOCK_PAYMENTS="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Taxa de serviço cobrada do jogador por cima do valor do organizador, em pontos-base (1000 = 10%)
PLATFORM_FEE_BPS="1000"

# ───────── E-mail ─────────
# Sem SMTP configurado os e-mails são gravados em .dev-mail/ e exibidos no console.
MAIL_FROM="PRiME ARENA MANAGER <no-reply@primearena.local>"
