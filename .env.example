# ───────── Banco de dados ─────────
# Desenvolvimento: SQLite. Produção: troque o provider em prisma/schema.prisma para "postgresql"
# e use uma URL como postgresql://user:pass@host:5432/primearena
DATABASE_URL="file:./dev.db?connection_limit=1&socket_timeout=30"

# ───────── Aplicação ─────────
APP_URL="http://localhost:3000"
# Chave para assinar tokens internos (gere com: openssl rand -hex 32)
APP_SECRET="troque-esta-chave-em-producao"

# ───────── Pagamentos ─────────
# "mock" = checkout simulado (somente dev/testes). "stripe" = Stripe Checkout (cartão + Pix).
# "none" = sem pagamento de inscrição (só campeonatos gratuitos): o modo mais simples para ir ao ar.
PAYMENTS_PROVIDER="mock"
# Em produção o provider mock é recusado, a menos que ALLOW_MOCK_PAYMENTS=true (não recomendado).
ALLOW_MOCK_PAYMENTS="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Taxa de serviço cobrada do jogador por cima do valor do organizador, em pontos-base (1000 = 10%)
PLATFORM_FEE_BPS="1000"

# ───────── E-mail ─────────
# Sem SMTP configurado os e-mails são gravados em .dev-mail/ e exibidos no console.
MAIL_FROM="Prime Arena <no-reply@primearena.local>"
SMTP_URL=""

# ───────── Administração ─────────
# E-mails que viram ADMIN (só valem com e-mail verificado)
ADMIN_EMAILS=""

# ───────── Proxy / IP de origem ─────────
# Em produção é OBRIGATÓRIO escolher. "true" só se houver proxy/CDN seu na frente que SOBRESCREVE x-forwarded-for;
# "false" ignora o cabeçalho (todos caem no mesmo balde de limite — falha fechada, nunca forjável).
TRUST_PROXY=""

# ───────── Carteira, depósitos e saques (créditos: 1 crédito = R$ 1,00) ─────────
WALLET_ENABLED="true"
# Pausa TODOS os saques (botão de emergência). Os depósitos e desafios continuam.
PAYOUTS_PAUSED="false"
# 32 bytes em base64 ou hex. Cifra o CPF (AES-256-GCM). FAÇA BACKUP: sem ela os CPFs não são recuperáveis.
# Gere com: openssl rand -base64 32
DATA_ENCRYPTION_KEY=""
# Segredo (24+ chars) para o agendador externo chamar /api/cron/wallet (Authorization: Bearer <segredo>)
CRON_SECRET=""

# "mock" = Pix simulado (somente dev/testes, página /dev/pix). "asaas" = Pix real via Asaas.
# "stripe" = depósitos por Pix cobrados pelo Stripe Checkout (usa STRIPE_SECRET_KEY e STRIPE_WEBHOOK_SECRET lá em cima).
# O Stripe NÃO paga Pix a terceiros: com ele os saques são pagos à mão pelo administrador (docs/CONFIGURAR_PIX.md, "Depósitos pelo Stripe").
PIX_PROVIDER="mock"
ALLOW_MOCK_PIX="false"
# "true" = todo depósito cujo pagador o provedor NÃO informa (o Asaas não informa) fica retido para o admin conferir e liberar
# em /admin/depositos, em vez de creditar sozinho. Recomendado ligar até validar o CPF do pagador no sandbox.
PIX_REQUIRE_PAYER_DOC="false"
# Só com PIX_PROVIDER="stripe": "false" não pede o CPF na página do Stripe (use se o Stripe recusar o campo);
# todo depósito então fica retido para o admin conferir. O padrão "true" pede o CPF (campo "CPF do titular da conta").
# STRIPE_PIX_COLLECT_TAX_ID="true"
# Só com PIX_PROVIDER="stripe": o CPF é DIGITADO pelo pagador (não confirmado pelo banco), então por padrão TODO depósito fica retido
# para o admin conferir o nome do pagador. "true" credita sozinho quando o CPF confere com um titular de identidade VERIFICADA (contornável).
# STRIPE_PIX_AUTO_CREDIT="false"
# "true" aceita chave de TESTE do Stripe (sk_test_) em produção, SÓ para ensaiar o fluxo num site SEPARADO, sem usuários de verdade:
# os créditos de um ensaio valem como dinheiro real na carteira. Nunca no site definitivo; não combina com STRIPE_PIX_AUTO_CREDIT.
# STRIPE_ALLOW_TEST_KEY="false"
ASAAS_API_KEY=""
ASAAS_ENV="sandbox"
# Token enviado pelo Asaas no cabeçalho do webhook de cobranças
ASAAS_WEBHOOK_TOKEN=""
# Token do webhook de autorização de transferências (o Asaas consulta antes de cada saque via API)
ASAAS_TRANSFER_AUTH_TOKEN=""

# ───────── Limites (centavos). Os padrões já são conservadores — ajuste só se souber o que está fazendo ─────────
# DEPOSIT_MIN_CENTS=1000          DEPOSIT_MAX_CENTS=500000        DEPOSIT_DAILY_USER_CENTS=1000000
# WITHDRAW_MIN_CENTS=2000         WITHDRAW_MAX_CENTS=200000       WITHDRAW_DAILY_TEAM_CENTS=500000
# WITHDRAW_AUTO_APPROVE_MAX_CENTS=30000   WITHDRAW_DELAY_MINUTES=30   WITHDRAW_REVIEW_RISK_THRESHOLD=40
# DEPOSIT_HOLD_HOURS=72           WIN_HOLD_HOURS=24               SECURITY_LOCK_HOURS=24
# STAKE_MIN_CENTS=100             STAKE_MAX_CENTS=50000           CHALLENGE_FEE_BPS=1000
# AUTO_SETTLE_MAX_STAKE_CENTS=10000   TEAM_MIN_AGE_HOURS=24       ACCOUNT_MIN_AGE_HOURS=24
