# Proxy com HTTPS automático (certificado grátis da Let's Encrypt, renovado sozinho).
# O endereço vem da variável DOMAIN do arquivo .env (ex.: DOMAIN=meusite.com.br).
{$DOMAIN} {
	encode zstd gzip

	# Limita o tamanho de qualquer envio (os formulários do site são pequenos).
	request_body {
		max_size 5MB
	}

	# O Caddy escreve o IP real do visitante em X-Forwarded-For (o site usa o último item, TRUST_PROXY=true).
	reverse_proxy app:3000
}
